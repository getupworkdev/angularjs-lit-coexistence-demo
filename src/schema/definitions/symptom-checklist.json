{
  "id": "symptom-checklist",
  "title": "Symptom checklist",
  "description": "Synthetic triage questionnaire.",
  "submitLabel": "Submit checklist",
  "sections": [
    {
      "title": "Current symptoms",
      "columns": 2,
      "fields": [
        { "name": "onsetDate", "label": "When did symptoms start?", "type": "date", "required": true, "width": "half" },
        {
          "name": "temperature", "label": "Temperature (°C)", "type": "number", "min": 30, "max": 45, "step": 0.1,
          "message": "Enter a temperature between 30 and 45.", "width": "half"
        },
        {
          "name": "severity", "label": "Overall severity", "type": "radio", "required": true,
          "options": [
            { "value": "mild", "label": "Mild" },
            { "value": "moderate", "label": "Moderate" },
            { "value": "severe", "label": "Severe" }
          ]
        }
      ]
    },
    {
      "title": "Checklist",
      "description": "Tick everything that applies.",
      "columns": 2,
      "fields": [
        { "name": "fever", "label": "Fever", "type": "checkbox", "width": "half" },
        { "name": "cough", "label": "Cough", "type": "checkbox", "width": "half" },
        { "name": "headache", "label": "Headache", "type": "checkbox", "width": "half" },
        { "name": "fatigue", "label": "Fatigue", "type": "checkbox", "width": "half" }
      ]
    },
    {
      "title": "Anything else",
      "fields": [
        { "name": "notes", "label": "Notes", "type": "textarea", "maxLength": 500, "rows": 4, "hint": "Up to 500 characters." }
      ]
    }
  ]
}
